# Copy this file to .env and fill in your values. Never commit .env.
NODE_ENV=development

# REST API for the web frontend, reached through the API Gateway (/api/resumes/* -> /api/*).
# Ports in use: 3000 frontend, 3001 Candidate Profile, 3002 Job Discovery, 3004 Application, 3005 Notification, 8080 gateway.
PORT=3006
# Web frontend origin allowed by CORS (only matters when calling this service directly).
CORS_ORIGIN=http://localhost:3000

# Internal gRPC API (GetApprovedResume) for the Application Service.
GRPC_HOST=0.0.0.0
GRPC_PORT=50053

# Resume Draft Store - owned exclusively by this service. Other services must NOT connect to it.
# A separate database on the same local MongoDB as the Job Posting Service is fine.
MONGODB_URI=mongodb://localhost:27017/rolefit_resume_preparation

# Upstream gRPC services (read-only; this service never touches their databases)
CANDIDATE_PROFILE_GRPC_URL=localhost:50051
JOB_POSTING_GRPC_URL=localhost:50052
GRPC_DEADLINE_MS=5000

# jwt (default): verify the Supabase access token the gateway forwards (ADR-008).
# mock: trust the X-User-Id header instead. Local testing only; refused when NODE_ENV=production.
AUTH_MODE=jwt
# Supabase Auth project (rolefit-auth): project URL + publishable key, never the secret key.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>

# AI Model Adapter (internal module, not a microservice).
# rule-based (default): deterministic, no external AI calls.
# gemini: Google Gemini API, falls back to rule-based on errors. Needs AI_API_KEY and AI_MODEL
# (the model id from AI Studio, e.g. gemini-3.5-flash-lite). Never commit the key.
AI_PROVIDER=rule-based
AI_API_KEY=
AI_MODEL=
